# Client (browser) — SpacetimeDB SDK connects over wss to maincloud
VITE_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB_NAME=custom-db-name

# Server-side match orchestrator — SpacetimeDB REST API + OpenRouter
SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
SPACETIMEDB_DB_NAME=custom-db-name
OPENROUTER_API_KEY=


OPENROUTER_MODEL=openai/gpt-4o-mini

# SpacetimeAuth (OIDC). Get the client_id from the maincloud dashboard:
# https://spacetimedb.com/overlap -> SpacetimeAuth -> Use SpacetimeAuth -> Clients
VITE_SPACETIMEAUTH_AUTHORITY=https://auth.spacetimedb.com/oidc
VITE_SPACETIMEAUTH_CLIENT_ID=
FIRECRAWL_API_KEY=
